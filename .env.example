# Pilih salah satu provider. Jangan commit file .env yang berisi secret.

# Gemini API (Google AI Studio) - direkomendasikan untuk analisis frame.
GEMINI_API_KEY=AIzaSy_your_key_here
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# Isi dengan model vision yang tersedia di akun Gemini Anda.
VISION_MODEL=gemini-2.5-flash

# Alternatif OpenAI-compatible provider:
# OPENAI_API_KEY=your_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

PORT=8765
